# Copy this file to .env (in this folder or in backend/) and fill in what you need.
# Never commit .env: it holds your broker keys.
#
# The defaults are safe: the fake broker, made-up prices and paper mode.
# Nothing touches a real account until you change BROKER and add keys.

# ------------------------------------------------------------------ where orders go
# fake = in-memory demo broker; alpaca = your Alpaca account (paper unless TRADING_MODE=live)
BROKER=fake
# paper or live. Live also needs LIVE_TRADING_CONFIRMED=true and BROKER=alpaca.
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false
# true = log what would be sent without sending anything
DRY_RUN=false
# Tags this account's orders and ledger rows. Use A for rules only and B for the AI test account.
ACCOUNT_LABEL=A

# ------------------------------------------------------------------ Alpaca
# Paper keys come from the paper dashboard at https://app.alpaca.markets (switch to Paper first).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Feed for historical bars: sip (full market, free for data older than 15 minutes) or iex
ALPACA_DATA_FEED=sip
# Feed for the latest price when sending orders: iex is free; sip needs a paid data plan
ALPACA_LATEST_FEED=iex

# ------------------------------------------------------------------ prices and storage
# synthetic = made-up prices; alpaca = Alpaca daily bars; csv = a file from `trader fetch-data`
DATA_SOURCE=synthetic
CSV_PATH=data/closes.csv
# Each account needs its own database: the app refuses to mix demo, paper and live records.
# Unset, it is demo.db with the fake broker and trader.db otherwise (both in backend/).
# For Postgres: postgresql+psycopg://user:password@host:5432/trader
# DATABASE_URL=sqlite:///./trader.db
FAKE_BROKER_STATE=data/fake_broker.json
REPORTS_DIR=reports

# ------------------------------------------------------------------ strategy
# trend (200-day average) or momentum (12-1 month momentum, top 3, monthly)
STRATEGY=trend
UNIVERSE=SPY,QQQ,IWM,EFA,EEM,TLT,IEF,GLD,DBC,VNQ
BENCHMARK=SPY

# ------------------------------------------------------------------ risk limits (percent of equity)
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=8.0
MAX_POSITION_PCT=10.0
MAX_OPEN_POSITIONS=8
DAILY_LOSS_LIMIT_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_ORDERS_PER_DAY=10
NO_TRADE_AFTER_OPEN_MIN=15
NO_TRADE_BEFORE_CLOSE_MIN=15
ENTRY_LIMIT_BUFFER_PCT=0.2
MAX_GAP_PCT=2.0
# Leave false: every order waits for your approval.
AUTO_APPROVE=false

# ------------------------------------------------------------------ AI research desk (Phase 3, paper account B)
# off, log_only (record the AI's view) or veto (the AI can block an entry, never add one)
AI_MODE=off
# null or tradingagents (pip install git+https://github.com/TauricResearch/TradingAgents.git)
AI_RESEARCHER=null
AI_VETO_RATINGS=underweight,sell
AI_MAX_CALLS_PER_DAY=5
# Your average LLM cost per research call, so Gate 3 can charge it against account B
AI_COST_PER_CALL_USD=0

# ------------------------------------------------------------------ Telegram approvals (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------ API and scheduler
# Set a long random value before the API is reachable from anywhere but your own machine.
API_TOKEN=
CORS_ORIGINS=http://localhost:5173
# true = run the 5:15 pm, 9:50 am and 4:30 pm ET jobs inside `trader serve`
ENABLE_SCHEDULER=false
TIMEZONE=America/New_York

# ------------------------------------------------------------------ Docker Compose only
# Password for the Postgres container that docker-compose.yml starts
POSTGRES_PASSWORD=change-me
